{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "input=$(cat); if [ \"$(printf '%s' \"$input\" | jq -r '.stop_hook_active // false')\" = \"true\" ]; then exit 0; fi; afplay \"$HOME/.config/herdr/sounds/notification.mp3\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 ~/.codex/hooks/kb-save.py",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/herdr/agent-doing.py || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/herdr/agent-doing.py || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.config/herdr/agent-doing.py || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
